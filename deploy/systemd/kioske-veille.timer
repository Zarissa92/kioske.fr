# Déclenche kioske-veille.service 2 min après le démarrage, puis à l'intervalle de kioske.cfg (intervalle_timer).
# Modèle : deploy/installer_serveur.sh remplace __INTERVALLE__.
[Unit]
Description=Lance la publication de la veille du KiosKe (toutes les __INTERVALLE__)

[Timer]
OnBootSec=2min
OnUnitActiveSec=__INTERVALLE__
Unit=kioske-veille.service
Persistent=true

[Install]
WantedBy=timers.target
